[Unit]
Description=Run iBetPro evidence capture every 10 minutes

[Timer]
# The route itself throttles paid provider syncs to 30 minutes. Running this
# timer every 10 minutes preserves live/pre-match evidence stages without
# multiplying paid Odds API discovery calls.
OnCalendar=*-*-* *:00/10:00
Persistent=true
AccuracySec=1min
RandomizedDelaySec=30s
Unit=ibetpro-sync.service

[Install]
WantedBy=timers.target
