[Unit]
Description=iBetPro Next.js Application
Documentation=https://ibetpro.lightworldtech.com
After=network.target mysql.service

[Service]
Type=simple
User=lightworld
Group=lightworld
WorkingDirectory=/home/lightworld/webapps/ibetpro/.next/standalone
EnvironmentFile=/home/lightworld/webapps/ibetpro/.next/standalone/.env
ExecStart=/usr/bin/node /home/lightworld/webapps/ibetpro/.next/standalone/server.js
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/lightworld/webapps/ibetpro/logs/out.log
StandardError=append:/home/lightworld/webapps/ibetpro/logs/error.log

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/lightworld/webapps/ibetpro/logs
PrivateTmp=true

# Resource limits
LimitNOFILE=65536
MemoryMax=512M

[Install]
WantedBy=multi-user.target
