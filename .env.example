# iBetPro environment template
# Copy to a local .env file and fill values securely. Never commit real secrets.

DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/ibetpro"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3017"
PORT="3017"
HOSTNAME="127.0.0.1"

# Football data providers
ODDS_API_KEY=""
API_FOOTBALL_KEY=""
SPORTMONKS_API_TOKEN=""
# Optional legacy alias supported by the web readiness check:
SPORTMONKS_API_KEY=""

# Prediction service
ML_SERVICE_URL="http://127.0.0.1:8000"
ML_SERVICE_TIMEOUT_MS="2500"

# baseline = local Poisson only
# shadow   = baseline is user-facing; trained candidate runs separately for evaluation
# active   = trained model is user-facing when available, with baseline fallback
ML_MODEL_MODE="baseline"

# ML service only: directory containing a promoted artifact bundle.
# Keep empty until a candidate has passed research gates and is intentionally installed.
IBETPRO_MODEL_DIR=""

# Data sync throttling
SYNC_INTERVAL_MIN="30"

# Quota-free global fixture discovery. The Odds API /sports and /events endpoints
# do not consume usage credits; paid odds enrichment is budgeted separately.
ODDS_DISCOVERY_INTERVAL_MIN="60"
ODDS_DISCOVERY_GROUPS="Soccer"
ODDS_DISCOVERY_MAX_SPORTS="60"
ODDS_DISCOVERY_CONCURRENCY="2"
ODDS_DISCOVERY_BATCH_DELAY_MS="250"
ODDS_DISCOVERY_RETRY_LIMIT="2"
ODDS_DISCOVERY_RETRY_DELAY_MS="1000"
ODDS_DISCOVERY_LIVE_WINDOW_MIN="240"

# Paid odds enrichment. Near-term competitions inside this window are prioritized
# before the configured core leagues, while the per-sync cap protects quota.
ODDS_NEAR_TERM_PRIORITY_HOURS="36"
ODDS_API_PAID_SPORTS_PER_SYNC="3"
ODDS_API_PRIORITY_SPORTS="soccer_epl,soccer_germany_bundesliga,soccer_spain_la_liga"
ODDS_REFRESH_MIN="360"

# First-party causal training gates. These match the deployed Python pilot validator.
FIRST_PARTY_PILOT_MIN_LABELED="300"
FIRST_PARTY_MIN_COMPLETENESS="0.70"
FIRST_PARTY_PROMOTION_MIN_LABELED="1500"

# Safety: server restarts and passive page loads do not resume betting bots by default.
# Set true only when automatic wager-execution recovery is intentionally desired.
AUTO_BET_RECOVERY_ENABLED="false"
