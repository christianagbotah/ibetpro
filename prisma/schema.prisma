generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  avatar         String?
  role           String   @default("user")
  balance        Float    @default(0)
  totalProfit    Float    @default(0)
  totalLoss      Float    @default(0)
  commissionPaid Float    @default(0)
  bankroll       Float    @default(1000)
  dailyPnl       Float    @default(0)
  weeklyPnl      Float    @default(0)
  region         String?  @default("ng") // user's country/region code
  currency       String?  @default("NGN") // currency code based on region
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bettingAccounts BettingAccount[]
  bets            Bet[]
  transactions    Transaction[]
  settings        UserSettings?
  accumulators    Accumulator[]
  botLogs         BotLog[]
  allocations     Allocation[]
  commissions     CommissionLedger[]
  botSession      BotSession?
  passwordResetTokens PasswordResetToken[]
  notifications        Notification[]
  tips                 Tip[]
}

model UserSettings {
  id                   String  @id @default(cuid())
  userId               String  @unique
  autoBettingEnabled   Boolean @default(true)
  maxBetAmount         Float   @default(100)
  minOddsThreshold     Float   @default(1.5)
  maxOddsThreshold     Float   @default(5.0)
  riskLevel            String  @default("medium")
  autoCashoutEnabled   Boolean @default(true)
  cashoutThreshold     Float   @default(0.7)
  commissionRate       Float   @default(0.10)
  preferredSports      String  @default("football,basketball,tennis")
  notificationsEnabled Boolean @default(true)
  dailyBetLimit        Float   @default(500)
  kellyFraction        Float   @default(0.25)
  minEdgeThreshold     Float   @default(0.03)
  // Enhanced auto-bet settings
  betTypes             String  @default("single,accumulator") // "single" | "accumulator" | "single,accumulator"
  maxAccumulatorLegs   Int     @default(5)
  minAiConfidence      Float   @default(0.6)
  stopLossDaily        Float   @default(200)
  stopLossWeekly       Float   @default(500)
  profitTargetDaily    Float   @default(300)
  profitTargetWeekly   Float   @default(1000)
  betScheduleStart     String  @default("08:00") // HH:mm - only place bets after this time
  betScheduleEnd       String  @default("22:00") // HH:mm - only place bets before this time
  partialCashoutEnabled Boolean @default(true)
  partialCashoutPercent Float  @default(0.5) // 50% partial cashout
  waitFullSettlement   Boolean @default(true) // wait for full match settlement for cashout
  // Broker mode: "demo" = sandbox/simulated, "real" = live broker API
  brokerMode           String  @default("demo") // "demo" | "real"
  // Bot mode: "advisor" = Phase 1, AI tips only (no auto-bet) | "auto" = Phase 2, auto-bet
  botMode              String  @default("advisor") // "advisor" | "auto"
  // Telegram notifications for AI tips
  telegramChatId       String?  // Telegram chat ID for tip alerts
  minTipConfidence     Float   @default(0.65) // minimum AI confidence to send tip alert
  tipSports            String  @default("football,basketball,tennis") // sports to receive tips for
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BettingAccount {
  id              String   @id @default(cuid())
  userId          String
  platform        String
  accountId       String
  accountName     String
  accessToken     String?
  refreshToken    String?
  balance         Float    @default(0)
  currency        String   @default("USD")
  isConnected     Boolean  @default(false)
  lastSyncedAt    DateTime?
  // Broker integration fields
  brokerType      String?  @default("manual") // "manual" | "oauth" | "api_key" | "web_session"
  brokerRegion    String?  // "ng" | "ke" | "gh" | "uk" | "eu" | "global"
  brokerUserId    String?  // user ID on the broker platform
  allocatedAmount Float    @default(0) // amount allocated by user for auto-betting
  maxAllocation   Float    @default(0) // max allocation the user has ever set
  allocationLock  Boolean  @default(false) // if true, allocation is locked during active bets
  sessionToken    String?  // active broker session token
  sessionExpiry   DateTime? // when the broker session expires
  lastBetPlacedAt DateTime? // last time a bet was placed via this broker
  totalBrokerBets Int      @default(0) // total bets placed through this broker
  totalBrokerProfit Float  @default(0) // total profit made through this broker
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bets        Bet[]
  allocations Allocation[]
  commissions CommissionLedger[]
}

model Match {
  id             String   @id @default(cuid())
  externalId     String?  @unique
  sport          String
  league         String
  homeTeam       String
  awayTeam       String
  homeOdds       Float
  drawOdds       Float?
  awayOdds       Float
  overUnderLine  Float?   @default(2.5)
  overOdds       Float?
  underOdds      Float?
  commenceTime   DateTime
  status         String   @default("upcoming")
  homeScore      Int?
  awayScore      Int?
  minute         Int?
  apiSource      String?  @default("manual")
  lastSyncedAt   DateTime?
  aiHomeWinProb  Float?   @default(0)
  aiDrawProb     Float?   @default(0)
  aiAwayWinProb  Float?   @default(0)
  aiConfidence   Float?   @default(0)
  aiAnalysis     String?
  aiRecommended  String?
  aiRiskScore    Float?   @default(50)
  aiRiskLevel    String?  @default("medium")
  aiValueEdge    Float?   @default(0)
  aiKellyStake   Float?   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bets Bet[]
  tips Tip[]

  @@index([status])
  @@index([sport, league])
  @@index([commenceTime])
}

model TeamStats {
  id                   String   @id @default(cuid())
  teamName             String
  sport                String
  league               String
  season               String
  matchesPlayed        Int      @default(0)
  wins                 Int      @default(0)
  draws                Int      @default(0)
  losses               Int      @default(0)
  goalsFor             Int      @default(0)
  goalsAgainst         Int      @default(0)
  form                 String?  @default("")
  homeRecord           String?  @default("")
  awayRecord           String?  @default("")
  attackRating         Float    @default(0)
  defenseRating        Float    @default(0)
  overallRating        Float    @default(0)
  eloRating            Float    @default(1500)
  xgFor                Float    @default(0)
  xgAgainst            Float    @default(0)
  shotsPerGame         Float    @default(0)
  shotsOnTargetPerGame Float    @default(0)
  possessionAvg        Float    @default(50)
  cornersPerGame       Float    @default(0)
  cardsPerGame         Float    @default(0)
  keyPlayers           String?  @default("[]")
  externalTeamId       Int?
  apiSource            String?  @default("manual")
  lastUpdated          DateTime @default(now())
  createdAt            DateTime @default(now())

  @@unique([teamName, sport, league, season])
}

model Bet {
  id              String    @id @default(cuid())
  userId          String
  bettingAccountId String
  matchId         String
  accumulatorId   String?   // link to accumulator if part of one
  betType         String    // "single" | "accumulator_leg" | "over_under" | "both_teams_score"
  selection       String
  odds            Float
  stake           Float
  potentialWin    Float
  status          String    @default("pending") // "pending" | "won" | "lost" | "cashed_out" | "partial_cashout" | "void" | "cancelled"
  cashoutAmount   Float?
  cashoutOdds     Float?
  partialCashoutAmount Float?  // amount already cashed out
  partialCashoutPercent Float? // percentage of stake cashed out
  profit          Float?
  commission      Float?
  isAutoPlaced    Boolean   @default(false)
  aiConfidence    Float?    @default(0)
  aiReasoning     String?
  aiModelUsed     String?   @default("ensemble")
  kellyStake      Float?    @default(0)
  valueEdge       Float?    @default(0)
  riskScore       Float?    @default(50)
  settlementReason String?  // "match_finished" | "cashout" | "partial_cashout" | "void_match"
  placedAt        DateTime  @default(now())
  settledAt       DateTime?
  cashedOutAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bettingAccount BettingAccount @relation(fields: [bettingAccountId], references: [id], onDelete: Cascade)
  match          Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  accumulator    Accumulator?  @relation(fields: [accumulatorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([matchId])
  @@index([status])
  @@index([accumulatorId])
}

model Accumulator {
  id              String   @id @default(cuid())
  userId          String
  totalOdds       Float    // combined odds of all legs
  stake           Float
  potentialWin    Float
  status          String   @default("pending") // "pending" | "won" | "lost" | "cashed_out" | "partial_cashout"
  cashoutAmount   Float?
  completedLegs   Int      @default(0)
  totalLegs       Int
  isAutoPlaced    Boolean  @default(false)
  bonusPercent    Float?   @default(0) // accumulator bonus
  profit          Float?
  commission      Float?
  placedAt        DateTime @default(now())
  settledAt       DateTime?
  cashedOutAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bets  Bet[]

  @@index([userId])
  @@index([userId, status])
  @@index([status])
}

model BotLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // "bet_placed" | "bet_skipped" | "cashout_executed" | "cashout_skipped" | "bet_settled" | "accumulator_created" | "stop_loss_hit" | "profit_target_hit" | "schedule_blocked" | "bot_started" | "bot_stopped" | "bot_scan" | "bot_match_found"
  matchId     String?
  betId       String?
  accumulatorId String?
  details     String?  // JSON string with additional context
  reasoning   String?  // AI reasoning for the decision
  confidence  Float?   @default(0)
  profitImpact Float?  @default(0) // how much this decision affected profit
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([action])
  @@index([createdAt])
}

// Bot session - tracks active bot runs for persistent background operation
model BotSession {
  id              String   @id @default(cuid())
  userId          String   @unique
  status          String   @default("stopped") // "running" | "stopped" | "paused"
  startedAt       DateTime?
  stoppedAt       DateTime?
  totalScans      Int      @default(0) // how many scan cycles completed
  totalBetsPlaced Int      @default(0) // bets placed during this session
  totalStakeUsed  Float    @default(0) // total stake used
  totalProfit     Float    @default(0) // profit from this session
  lastScanAt      DateTime? // when the last scan cycle ran
  lastBetAt       DateTime? // when the last bet was placed
  scanIntervalSec Int      @default(30) // seconds between scan cycles
  stopReason      String?  // "user_stopped" | "stop_loss" | "profit_target" | "schedule" | "error" | "no_allocation"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "bet_placed" | "bet_won" | "bet_lost" | "cashout" | "partial_cashout" | "commission" | "deposit" | "withdrawal" | "accumulator_bonus"
  amount      Float
  currency    String   @default("USD")
  status      String   @default("completed")
  description String?
  betId       String?
  accumulatorId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model AdminSettings {
  id                    String  @id @default(cuid())
  defaultCommissionRate Float   @default(0.10)
  minCommissionRate     Float   @default(0.05)
  maxCommissionRate     Float   @default(0.25)
  platformName          String  @default("iBetPro")
  maintenanceMode       Boolean @default(false)
  maxUsers              Int     @default(10000)
  autoApproveAccounts   Boolean @default(true)
  oddsApiKey            String? @default("")
  apiFootballKey        String? @default("")
  accumulatorBonusThresholds String? @default("[]") // JSON: [{legs: 4, bonus: 5}, {legs: 5, bonus: 10}, {legs: 6, bonus: 20}]
  // Admin wallet for commission collection
  adminWalletAddress    String? @default("") // payment address for commission
  adminBankName         String? @default("")
  adminAccountNumber    String? @default("")
  autoCommissionTransfer Boolean @default(true) // auto-transfer commission to admin
  minimumCommissionPayout Float @default(10) // minimum commission before auto-transfer
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Allocation tracking - how much the user has allocated from their broker
model Allocation {
  id              String   @id @default(cuid())
  userId          String
  bettingAccountId String
  amount          Float    // amount allocated
  previousAmount  Float    @default(0) // previous allocation for audit
  status          String   @default("active") // "active" | "released" | "locked" | "partial"
  usedAmount      Float    @default(0) // how much of allocation has been used for bets
  remainingAmount Float    @default(0) // how much is still available
  profitFromAlloc Float    @default(0) // profit generated from this allocation
  commissionFromAlloc Float @default(0) // commission generated from this allocation
  activatedAt     DateTime @default(now())
  releasedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bettingAccount BettingAccount @relation(fields: [bettingAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bettingAccountId])
  @@index([status])
}

// Commission ledger - tracks all commission deductions and transfers to admin
model CommissionLedger {
  id              String   @id @default(cuid())
  userId          String
  bettingAccountId String
  betId           String?
  accumulatorId   String?
  grossProfit     Float    @default(0) // profit before commission
  commissionRate  Float    @default(0.10) // commission rate at time of deduction
  commissionAmount Float   @default(0) // amount deducted
  netProfit       Float    @default(0) // profit after commission
  status          String   @default("pending") // "pending" | "transferred" | "failed" | "refunded"
  transferRef     String?  // reference for the transfer to admin
  transferredAt   DateTime? // when commission was transferred to admin
  failureReason   String?  // reason if transfer failed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bettingAccount BettingAccount @relation(fields: [bettingAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bettingAccountId])
  @@index([status])
  @@index([createdAt])
}

// AI Model performance tracking
model AIModelPerformance {
  id              String   @id @default(cuid())
  modelVersion    String   @default("v2_ensemble")
  totalPredictions Int     @default(0)
  correctPredictions Int   @default(0)
  accuracyRate    Float    @default(0)
  avgConfidence   Float    @default(0)
  avgValueEdge    Float    @default(0)
  totalProfit     Float    @default(0)
  totalLoss       Float    @default(0)
  roi             Float    @default(0)
  sharpeRatio     Float    @default(0)
  maxDrawdown     Float    @default(0)
  sport           String   @default("all")
  period          String   @default("daily") // "daily" | "weekly" | "monthly"
  periodStart     DateTime
  periodEnd       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([modelVersion])
  @@index([sport])
  @@index([period])
}

// Password reset tokens for forgot-password flow
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// In-app notifications for AI tips and system alerts
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String   @default("info") // "ai_tip" | "info" | "warning" | "success"
  read      Boolean  @default(false)
  matchId   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

// AI Tips - tracked recommendations with outcome tracking (Phase 1: Advisor Model)
model Tip {
  id              String    @id @default(cuid())
  userId          String
  matchId         String
  sport           String
  league          String
  homeTeam        String
  awayTeam        String
  selection       String
  odds            Float
  aiConfidence    Float
  valueEdge       Float
  kellyStake      Float
  riskLevel       String    @default("medium")
  aiReasoning     String?
  // User tracking: did they follow the tip?
  tracked         Boolean   @default(false) // user marked "I'll bet this"
  userStake       Float?    // how much the user actually staked
  userResult      String?   // "won" | "lost" | "void" — user-reported result
  userProfit      Float?    // user-reported profit/loss
  userResultAt    DateTime? // when user reported the result
  // Outcome (filled when match settles — AI outcome tracking)
  outcome         String?   // "won" | "lost" | "void" | "pending"
  actualOdds      Float?
  profit          Float?
  commencesAt     DateTime  // match start time
  settledAt       DateTime?
  // Notification delivery tracking
  telegramSent    Boolean   @default(false) // whether Telegram alert was sent
  telegramSentAt  DateTime? // when the Telegram alert was sent
  createdAt       DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, outcome])
  @@index([userId, tracked])
  @@index([matchId])
  @@index([commencesAt])
  @@index([createdAt])
}
