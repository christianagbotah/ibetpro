generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  avatar         String?
  role           String   @default("user")
  balance        Float    @default(0)
  totalProfit    Float    @default(0)
  totalLoss      Float    @default(0)
  commissionPaid Float    @default(0)
  bankroll       Float    @default(1000)
  dailyPnl       Float    @default(0)
  weeklyPnl      Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bettingAccounts BettingAccount[]
  bets            Bet[]
  transactions    Transaction[]
  settings        UserSettings?
  accumulators    Accumulator[]
  botLogs         BotLog[]
}

model UserSettings {
  id                   String  @id @default(cuid())
  userId               String  @unique
  autoBettingEnabled   Boolean @default(false)
  maxBetAmount         Float   @default(100)
  minOddsThreshold     Float   @default(1.5)
  maxOddsThreshold     Float   @default(5.0)
  riskLevel            String  @default("medium")
  autoCashoutEnabled   Boolean @default(true)
  cashoutThreshold     Float   @default(0.7)
  commissionRate       Float   @default(0.10)
  preferredSports      String  @default("football,basketball,tennis")
  notificationsEnabled Boolean @default(true)
  dailyBetLimit        Float   @default(500)
  kellyFraction        Float   @default(0.25)
  minEdgeThreshold     Float   @default(0.03)
  // Enhanced auto-bet settings
  betTypes             String  @default("single,accumulator") // "single" | "accumulator" | "single,accumulator"
  maxAccumulatorLegs   Int     @default(5)
  minAiConfidence      Float   @default(0.6)
  stopLossDaily        Float   @default(200)
  stopLossWeekly       Float   @default(500)
  profitTargetDaily    Float   @default(300)
  profitTargetWeekly   Float   @default(1000)
  betScheduleStart     String  @default("08:00") // HH:mm - only place bets after this time
  betScheduleEnd       String  @default("22:00") // HH:mm - only place bets before this time
  partialCashoutEnabled Boolean @default(true)
  partialCashoutPercent Float  @default(0.5) // 50% partial cashout
  waitFullSettlement   Boolean @default(true) // wait for full match settlement for cashout
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BettingAccount {
  id           String   @id @default(cuid())
  userId       String
  platform     String
  accountId    String
  accountName  String
  accessToken  String?
  refreshToken String?
  balance      Float    @default(0)
  currency     String   @default("USD")
  isConnected  Boolean  @default(false)
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bets Bet[]
}

model Match {
  id             String   @id @default(cuid())
  externalId     String?  @unique
  sport          String
  league         String
  homeTeam       String
  awayTeam       String
  homeOdds       Float
  drawOdds       Float?
  awayOdds       Float
  overUnderLine  Float?   @default(2.5)
  overOdds       Float?
  underOdds      Float?
  commenceTime   DateTime
  status         String   @default("upcoming")
  homeScore      Int?
  awayScore      Int?
  minute         Int?
  apiSource      String?  @default("manual")
  lastSyncedAt   DateTime?
  aiHomeWinProb  Float?   @default(0)
  aiDrawProb     Float?   @default(0)
  aiAwayWinProb  Float?   @default(0)
  aiConfidence   Float?   @default(0)
  aiAnalysis     String?
  aiRecommended  String?
  aiRiskScore    Float?   @default(50)
  aiRiskLevel    String?  @default("medium")
  aiValueEdge    Float?   @default(0)
  aiKellyStake   Float?   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bets Bet[]

  @@index([status])
  @@index([sport, league])
  @@index([commenceTime])
}

model TeamStats {
  id                   String   @id @default(cuid())
  teamName             String
  sport                String
  league               String
  season               String
  matchesPlayed        Int      @default(0)
  wins                 Int      @default(0)
  draws                Int      @default(0)
  losses               Int      @default(0)
  goalsFor             Int      @default(0)
  goalsAgainst         Int      @default(0)
  form                 String?  @default("")
  homeRecord           String?  @default("")
  awayRecord           String?  @default("")
  attackRating         Float    @default(0)
  defenseRating        Float    @default(0)
  overallRating        Float    @default(0)
  eloRating            Float    @default(1500)
  xgFor                Float    @default(0)
  xgAgainst            Float    @default(0)
  shotsPerGame         Float    @default(0)
  shotsOnTargetPerGame Float    @default(0)
  possessionAvg        Float    @default(50)
  cornersPerGame       Float    @default(0)
  cardsPerGame         Float    @default(0)
  keyPlayers           String?  @default("[]")
  externalTeamId       Int?
  apiSource            String?  @default("manual")
  lastUpdated          DateTime @default(now())
  createdAt            DateTime @default(now())

  @@unique([teamName, sport, league, season])
}

model Bet {
  id              String    @id @default(cuid())
  userId          String
  bettingAccountId String
  matchId         String
  accumulatorId   String?   // link to accumulator if part of one
  betType         String    // "single" | "accumulator_leg" | "over_under" | "both_teams_score"
  selection       String
  odds            Float
  stake           Float
  potentialWin    Float
  status          String    @default("pending") // "pending" | "won" | "lost" | "cashed_out" | "partial_cashout" | "void" | "cancelled"
  cashoutAmount   Float?
  cashoutOdds     Float?
  partialCashoutAmount Float?  // amount already cashed out
  partialCashoutPercent Float? // percentage of stake cashed out
  profit          Float?
  commission      Float?
  isAutoPlaced    Boolean   @default(false)
  aiConfidence    Float?    @default(0)
  aiReasoning     String?
  aiModelUsed     String?   @default("ensemble")
  kellyStake      Float?    @default(0)
  valueEdge       Float?    @default(0)
  riskScore       Float?    @default(50)
  settlementReason String?  // "match_finished" | "cashout" | "partial_cashout" | "void_match"
  placedAt        DateTime  @default(now())
  settledAt       DateTime?
  cashedOutAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bettingAccount BettingAccount @relation(fields: [bettingAccountId], references: [id], onDelete: Cascade)
  match          Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  accumulator    Accumulator?  @relation(fields: [accumulatorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([matchId])
  @@index([status])
  @@index([accumulatorId])
}

model Accumulator {
  id              String   @id @default(cuid())
  userId          String
  totalOdds       Float    // combined odds of all legs
  stake           Float
  potentialWin    Float
  status          String   @default("pending") // "pending" | "won" | "lost" | "cashed_out" | "partial_cashout"
  cashoutAmount   Float?
  completedLegs   Int      @default(0)
  totalLegs       Int
  isAutoPlaced    Boolean  @default(false)
  bonusPercent    Float?   @default(0) // accumulator bonus
  profit          Float?
  commission      Float?
  placedAt        DateTime @default(now())
  settledAt       DateTime?
  cashedOutAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bets  Bet[]

  @@index([userId])
  @@index([userId, status])
  @@index([status])
}

model BotLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // "bet_placed" | "bet_skipped" | "cashout_executed" | "cashout_skipped" | "bet_settled" | "accumulator_created" | "stop_loss_hit" | "profit_target_hit" | "schedule_blocked"
  matchId     String?
  betId       String?
  accumulatorId String?
  details     String?  // JSON string with additional context
  reasoning   String?  // AI reasoning for the decision
  confidence  Float?   @default(0)
  profitImpact Float?  @default(0) // how much this decision affected profit
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([action])
  @@index([createdAt])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "bet_placed" | "bet_won" | "bet_lost" | "cashout" | "partial_cashout" | "commission" | "deposit" | "withdrawal" | "accumulator_bonus"
  amount      Float
  currency    String   @default("USD")
  status      String   @default("completed")
  description String?
  betId       String?
  accumulatorId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model AdminSettings {
  id                    String  @id @default(cuid())
  defaultCommissionRate Float   @default(0.10)
  minCommissionRate     Float   @default(0.05)
  maxCommissionRate     Float   @default(0.25)
  platformName          String  @default("iBetPro")
  maintenanceMode       Boolean @default(false)
  maxUsers              Int     @default(10000)
  autoApproveAccounts   Boolean @default(true)
  oddsApiKey            String? @default("")
  apiFootballKey        String? @default("")
  accumulatorBonusThresholds String? @default("[]") // JSON: [{legs: 4, bonus: 5}, {legs: 5, bonus: 10}, {legs: 6, bonus: 20}]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
